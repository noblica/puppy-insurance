{
  "name": "puppy-insurance",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@nordhealth/components": "4.20.0",
    "@nordhealth/css": "5.0.8",
    "@nordhealth/fonts": "3.0.4",
    "@nordhealth/themes": "9.0.7",
    "@nordhealth/tokens": "8.0.5",
    "@regle/core": "1.26.1",
    "@regle/nuxt": "1.26.1",
    "@regle/rules": "1.26.1",
    "@tailwindcss/vite": "4.3.0",
    "nuxt": "3.21.2",
    "tailwindcss": "4.3.0",
    "vue": "3.5.34",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@nuxt/test-utils": "4.0.3",
    "@playwright/test": "1.60.0",
    "@vue/test-utils": "2.4.10",
    "happy-dom": "20.9.0",
    "lint-staged": "^15.5.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "simple-git-hooks": "^2.12.1",
    "vitest": "4.1.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.26.2"
}
